# Database
DB_ROOT_PASSWORD=change-me-root-password
DB_NAME=equipment_loan
DB_USER=equipment_loan
DB_PASSWORD=change-me-app-password

# Local development only (docker compose overrides these)
DB_HOST=localhost
DB_PORT=3306
PORT=8080

# Auth - generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=24h

# Host port the web UI is published on
WEB_PORT=3000